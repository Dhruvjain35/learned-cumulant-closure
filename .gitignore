# Python
__pycache__/
*.pyc
.venv/
*.egg-info/

# macOS / editors
.DS_Store

# Julia: Manifest.toml IS committed on purpose. This is a reproduction environment, not a library -- the
# whole point is that a collaborator instantiates the exact dependency set the script was executed against.
# Leaving it unpinned is what caused the API-drift failures in the first external run.

# large regenerable data artifacts (regenerate via gen_*.py / fit_*.py / mc_ref.py)
results/train_*.npz
results/transfer_*.npz
results/local_train.npz
results/gen_*.npz
results/mcref_*.npz
results/pocket_*.npz

# superseded model pickles (frozen V7 uses lc_v3dens.pkl + lc_v6.pkl, which ARE tracked)
results/lc_old.pkl
results/lc_new.pkl
results/lc_v4.pkl
results/lc_v4p.pkl
results/lc_v5.pkl

# portable_v7 run outputs (returned external runs are archived under external_validation/ instead)
portable_v7/external_output/
portable_v7/selfcheck_output/

# paper build outputs (rebuilt by `make paper` / `make supplement`; PDFs carry the build date)
paper/*.pdf
paper/*.log
paper/*.blg
paper/*.aux
paper/*.bbl
paper/*Notes.bib
paper/*.out

# local release / arXiv previews (generated; only release/templates/ is tracked)
release/*
!release/templates/
