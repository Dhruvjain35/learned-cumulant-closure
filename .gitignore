# macOS / editors
.DS_Store

# Julia: Manifest.toml IS committed on purpose. This is a reproduction environment, not a library -- the
# whole point is that a collaborator instantiates the exact dependency set the script was executed against.
# Leaving it unpinned is what caused the API-drift failures in the first external run.

# large regenerable data artifacts (regenerate via gen_*.py / fit_*.py / mc_ref.py)
results/train_*.npz
results/transfer_*.npz
results/local_train.npz
results/gen_*.npz
results/mcref_*.npz
results/pocket_*.npz

